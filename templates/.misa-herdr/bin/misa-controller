#!/bin/zsh
# Start the coordinator as Claude Code. Workers are separately managed OMP processes.
set -euo pipefail

script_dir=${0:A:h}
runtime_dir=${script_dir:h}
workspace_dir=${runtime_dir:h}

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
  print 'Usage: ./.misa-herdr/bin/misa-controller [Claude Code user prompt arguments]'
  exit 0
fi

for argument in "$@"; do
  case "$argument" in
    --agent|--agent=*|--mcp-config|--mcp-config=*)
      print -u2 'misa-controller fixes the Claude Code Misa role and project MCP configuration.'
      exit 2
      ;;
  esac
done

cd "$workspace_dir"
exec claude --agent misa "$@"
